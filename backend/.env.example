# Backend (.env) — kopiraj v .env in vpiši svoje vrednosti.
# Vsaj en način pisanja v bazo mora biti nastavljen.

# 1) Neposredna PostgreSQL povezava (omogoči repair + dedupe fazi)
SUPABASE_DB_URI=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 2) REST API (PostgREST) — uporabi se, če PostgreSQL ni nastavljen
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# 3) Neobvezno: poročila o izločenih oglasih
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=podpora@example.com
